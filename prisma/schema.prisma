// Prisma schema for the Porto family finance app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = postgresql
  url      = env("DATABASE_URL")
}

// A workbook is a complete independent spreadsheet (e.g. "Porto 2026", "Vitória 2026").
// All categories, subgroups, notes, and budgets belong to a workbook.
// Switching workbooks shows a completely different set of data.
model Workbook {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories Category[]
  subgroups  Subgroup[]
  notes      Note[]
  topGroups  TopGroup[]
}

// User-customizable top-level groups (cards). Default ones (despesas, rendimentos,
// reservas) are seeded, but the user can create new ones, rename, recolor, and delete.
model TopGroup {
  id         String   @id @default(cuid())
  workbookId String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  key        String   // slug like "despesas", "investimentos", "viagens"
  name       String   // display name
  color      String   @default("#64748b") // hex color for the card background accent
  sortOrder  Int      @default(0)
  type       String   @default("EXPENSE") // "EXPENSE" | "INCOME" | "RESERVE"
  isDefault  Boolean  @default(false) // true for despesas/rendimentos/reservas
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workbookId, key])
}

// A category groups transactions (e.g. "Aluguel", "Nubank Kiki", "Salario Breno")
model Category {
  id          String   @id @default(cuid())
  workbookId  String
  workbook    Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  name        String
  group       String
  type        String   // "EXPENSE" | "INCOME" | "RESERVE"
  currency    String   @default("BRL")
  note        String?
  sortOrder   Int      @default(0)
  autoConvert Boolean  @default(false)
  excludeFromTotal Boolean @default(false)
  monthlyGoal Float?
  // Optional custom color (hex like "#dc2626"). When null, uses the group color.
  color String?
  parentCategoryId String?
  parent          Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  children        Category[] @relation("CategoryTree")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
}

// A transaction is a value for a given (category, month).
model Transaction {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  year        Int      @default(2026)
  month       Int
  value       Float
  note        String?

  // Recurrence fields
  isRecurring       Boolean  @default(false)
  seriesId          String?
  installmentNumber Int?
  installmentsTotal Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, year, month])
}

// Key/value config store (global config like euroToBrl)
model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// User-created subgroups.
model Subgroup {
  id         String   @id @default(cuid())
  workbookId String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  key        String
  parentKey  String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workbookId, key])
}

// Activity log for who changed what
model ActivityLog {
  id        String   @id @default(cuid())
  user      String
  action    String
  entity    String
  detail    String
  createdAt DateTime @default(now())
}

// Free-form notes per (workbook, year, month).
model Note {
  id          String   @id @default(cuid())
  workbookId  String
  workbook    Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  text        String
  user        String   @default("Anônimo")
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workbookId, year, month])
}
