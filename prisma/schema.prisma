// Prisma schema for the Porto family finance app

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A category groups transactions (e.g. "Aluguel", "Nubank Kiki", "Salario Breno")
// type controls sign and UI grouping.
//   EXPENSE  -> saída (negative contribution to balance)
//   INCOME   -> entrada (positive)
//   RESERVE  -> reserva (savings, neutral on monthly P&L)
//
// group is hierarchical:
//   "despesas"                    -> top-level "Despesas"
//   "despesas.cartoes"            -> subgroup "Cartões BR" inside Despesas
//   "despesas.contas_casa"        -> subgroup "Contas casa" inside Despesas
//   "rendimentos"                 -> top-level "Rendimentos"
//   "rendimentos.brl"             -> subgroup "Em Real (R$)" inside Rendimentos
//   "rendimentos.eur"             -> subgroup "Em Euro (€)" inside Rendimentos
//   "rendimentos.valores_a_receber" -> subgroup "Valores a receber" inside Rendimentos
//   "reservas"                    -> top-level "Reservas" (no subgroups)
model Category {
  id          String   @id @default(cuid())
  name        String
  group       String
  type        String   // "EXPENSE" | "INCOME" | "RESERVE"
  currency    String   @default("BRL")
  note        String?
  sortOrder   Int      @default(0)
  autoConvert Boolean  @default(false)
  // When true, this category's values are NOT included in the monthly balance
  // by default (e.g. "valores a receber").
  excludeFromTotal Boolean @default(false)
  // Optional monthly goal. For EXPENSE categories, this is a maximum spend;
  // for INCOME, a minimum target. UI shows a warning when exceeded.
  monthlyGoal Float?
  // Parent category for tree nesting. null = direct child of the group.
  // When a category has children, it shows a chevron and its total includes
  // the sum of all descendants.
  parentCategoryId String?
  parent          Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  children        Category[] @relation("CategoryTree")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
}

// A transaction is a value for a given (category, month).
// month is 1-12. year defaults to 2026.
model Transaction {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  year        Int      @default(2026)
  month       Int
  value       Float
  note        String?

  // Recurrence fields
  isRecurring       Boolean  @default(false)
  seriesId          String?  // groups transactions in the same recurring series
  installmentNumber Int?     // 1-indexed within series (null for non-recurring or infinite)
  installmentsTotal Int?     // total installments in series (null = infinite)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, year, month])
}

// Key/value config store
model Config {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// User-created subgroups. Allow N-level nesting inside top-level groups.
// `key` is the full dot-separated path, e.g. "despesas.contas_casa.mesada_breno".
// `parentKey` is the parent path (or the top-level key for first-level subgroups).
// Top-level groups (despesas, rendimentos, reservas) and their default subgroups
// (cartoes, contas_casa, etc.) are NOT stored here — they come from GROUP_STRUCTURE
// in code. Only user-created subgroups are stored.
model Subgroup {
  id        String   @id @default(cuid())
  key       String   @unique
  parentKey String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Activity log for who changed what
model ActivityLog {
  id        String   @id @default(cuid())
  user      String
  action    String   // "create" | "update" | "delete"
  entity    String   // "transaction" | "category" | "config" | "label" | "subgroup"
  detail    String
  createdAt DateTime @default(now())
}
